{
  "name": "tubesnag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A fast, open-source desktop app for grabbing YouTube videos as MP3 or MP4 — built with Tauri, React, and yt-dlp.",
  "author": "Samir Wagle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamirWagle/tubesnag.git"
  },
  "keywords": [
    "youtube-downloader",
    "yt-dlp",
    "tauri",
    "desktop-app",
    "mp3-downloader",
    "video-downloader"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
